# Elastic Beanstalk option settings for the Ringwise backend.
#
# This file holds NO secret values and no environment-specific values. Environment variable
# NAMES the app reads are listed below; set plain values in the environment configuration and
# map secrets with the aws:elasticbeanstalk:application:environmentsecrets namespace (Secrets
# Manager or SSM Parameter Store ARNs, platform versions released on or after 2025-03-26).
#
#   Secrets (environmentsecrets -> ARN):
#     PAWAPAY_API_TOKEN   pawaPay bearer token (sandbox and production are different tokens)
#     SECRET_KEY          Flask session signing key
#     DATABASE_URL        postgresql://user:pass@host:5432/db (RDS)
#     INTERNAL_TOKEN      shared secret for POST /internal/reconcile outside the worker tier
#
#   Plain environment properties:
#     PAWAPAY_BASE_URL            https://api.sandbox.pawapay.io or https://api.pawapay.io
#     PAWAPAY_REQUIRE_SIGNATURE   true once signed callbacks are enabled in the pawaPay dashboard
#     RECONCILE_AFTER_SECONDS     900 (pawaPay recommends rechecking after 15 minutes)
#     PUBLIC_BASE_URL             https://your-domain (turns on Secure cookies)
#     SCHEDULER_ENABLED           false on the web tier when a worker tier runs cron.yaml
#     EB_WORKER                   true on the worker tier only
#     TRUST_PROXY_HOPS            1 (ALB -> nginx -> gunicorn; verify on an instance)
#     GIT_COMMIT                  optional, shown in /healthz
#
# Example mapping (run once per environment, values are ARNs, never the secret itself):
#   aws elasticbeanstalk update-environment --environment-name ringwise-prod --option-settings \
#     Namespace=aws:elasticbeanstalk:application:environmentsecrets,OptionName=PAWAPAY_API_TOKEN,Value=arn:aws:secretsmanager:REGION:ACCOUNT:secret:ringwise/pawapay-token-AbCdEf

option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /healthz
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /healthz
    MatcherHTTPCode: "200"
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
