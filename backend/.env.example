# Copy to backend/.env for local development. .env is gitignored; never commit real values.
DATABASE_URL=postgresql:///ringwise_dev
SECRET_KEY=change-me-local-only
# Sandbox token from https://dashboard.sandbox.pawapay.io (leave empty to run read-only)
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_REQUIRE_SIGNATURE=false
RECONCILE_AFTER_SECONDS=60
INTERNAL_TOKEN=change-me-local-only
# An http loopback URL here keeps the session cookie usable over plain http locally. In any
# deployment set the https URL; with PUBLIC_BASE_URL unset the cookie is Secure by default.
PUBLIC_BASE_URL=http://127.0.0.1:5001
# SESSION_COOKIE_SECURE=false   only for plain-http testing on a LAN address
